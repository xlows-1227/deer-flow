# Serper API Key (Google Search) - https://serper.dev
SERPER_API_KEY=your-serper-api-key

# TAVILY API Key
TAVILY_API_KEY=your-tavily-api-key

# Jina API Key
JINA_API_KEY=your-jina-api-key

# InfoQuest API Key
INFOQUEST_API_KEY=your-infoquest-api-key
# Browser CORS allowlist for split-origin or port-forwarded deployments (comma-separated exact origins).
# Leave unset when using the unified nginx endpoint, e.g. http://localhost:2026.
# GATEWAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated trusted reverse proxy CIDRs for CSRF/Origin resolution.
# Docker Compose defaults to the fixed deer-flow network CIDR
# (192.168.210.0/24 for prod, 192.168.200.0/24 for dev) so the bundled nginx is
# trusted. In Kubernetes / VPC deployments, set this to the exact proxy subnet
# (e.g. the nginx Pod CIDR or ingress load balancer range).
# GATEWAY_TRUSTED_PROXIES=127.0.0.1,::1

# Optional:
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# VOLCENGINE_API_KEY=your-volcengine-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# VLLM_API_KEY=your-vllm-api-key  # OpenAI-compatible
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Enable LangSmith to monitor and debug your LLM calls, agent runs, and tool executions.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# GitHub API Token
# GITHUB_TOKEN=your-github-token

# Database (config.yaml: database.backend: postgres)
# Local `make dev`: use localhost. Docker Compose overrides DATABASE_URL to postgres:5432.
# POSTGRES_USER=deerflow
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=deerflow
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://deerflow:change-me-in-production@localhost:5432/deerflow
# UV_EXTRAS=postgres
#
# WECOM_BOT_ID=your-wecom-bot-id
# WECOM_BOT_SECRET=your-wecom-bot-secret
# DINGTALK_CLIENT_ID=your-dingtalk-client-id
# DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret

# Set to "false" to disable Swagger UI, ReDoc, and OpenAPI schema in production
# GATEWAY_ENABLE_DOCS=false

# Stable secret used to HMAC External API Keys. Changing it invalidates all existing Keys.
# EXTERNAL_API_KEY_PEPPER=replace-with-at-least-32-random-characters

# ── LDAP 内网账户登录 ──────────────────────────────────────────────────────────
# 启用后，除 AUTH_LDAP_LOCAL_ADMIN_EMAIL 指定的管理员账户仍用本地密码外，
# 其余账户一律走 LDAP（严格模式：LDAP 失败不回退本地密码）。
# 登录输入 sAMAccountName（不含 @yumchina.com）。
# 默认关闭（不设或 false 时所有账户走本地数据库）。
# AUTH_LDAP_ENABLED=false
# AUTH_LDAP_URL=ldap://ldap.yumchina.com
# AUTH_LDAP_BASE=ou=YumChina,DC=cn,DC=YumChina,DC=com
# AUTH_LDAP_BIND_USERNAME=serv-it-StarRocks
# AUTH_LDAP_BIND_PASSWORD=Yumc!0906
# 用户唯一标识属性（百胜员工与外部员工混用时用 sAMAccountName）
# AUTH_LDAP_OBJECTCLASS=sAMAccountName
# AUTH_LDAP_ATTR_REALNAME=givenName
# AUTH_LDAP_ATTR_SN=sn
# AUTH_LDAP_ATTR_EMAIL=mail
# 始终使用本地密码登录的管理员账户（含或不含域名均可）
# AUTH_LDAP_LOCAL_ADMIN_EMAIL=admin@yumchina.com
# 当 LDAP 条目没有 mail 属性时拼接的邮箱域名
# AUTH_LDAP_DOMAIN=@yumchina.com

# ── Frontend SSR → Gateway wiring ─────────────────────────────────────────────
# The Next.js server uses these to reach the Gateway during SSR (auth checks,
# /api/* rewrites). They default to localhost values that match `make dev` and
# `make start`, so most local users do not need to set them.
#
# Override only when the Gateway is not on localhost:8001 (e.g. when the
# frontend and gateway run on different hosts, in containers with a service
# alias, or behind a different port). docker-compose already sets these.
# DEER_FLOW_INTERNAL_GATEWAY_BASE_URL=http://localhost:8001
# DEER_FLOW_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:2026
